# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Banco local (PGlite)
/.data

# Conteúdo do curso — arquivos grandes ficam fora do Git
/content/videos/*
!/content/videos/.gitkeep

# Materiais com storage "r2" moram no bucket, não no repo — evita recommitar
# por engano cópias locais como as de content/materials/jack-hannaford-*.
/content/materials/*
!/content/materials/.gitkeep

# Cópia local da pasta original enviada ao R2 — fora do Git, mantida só na máquina.
/Módulo 02/
